<mujoco model="sat_booms">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 0" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.05 0.05 0.12" rgb2="0 0 0" width="512" height="512"/>
    <material name="bus_mat"  rgba="0.85 0.85 0.9 1"/>
    <material name="boom_x"   rgba="0.9 0.2 0.2 1"/>
    <material name="boom_y"   rgba="0.2 0.8 0.3 1"/>
    <material name="boom_z"   rgba="0.2 0.4 0.95 1"/>
  </asset>

  <default>
    <joint type="hinge" limited="true" range="-90 90" damping="0.01" armature="0.001"/>
    <geom contype="0" conaffinity="0"/>   <!-- no contacts needed in free space -->
    <motor ctrlrange="-0.5 0.5" ctrllimited="true"/>
  </default>

  <worldbody>
    <light pos="2 -2 3" dir="-1 1 -1.5" diffuse="0.9 0.9 0.9"/>

    <!-- Satellite bus: 0.2 x 0.2 x 0.3 m, 10 kg -->
    <body name="bus" pos="0 0 0">
      <freejoint name="bus_free"/>
      <geom name="bus_box" type="box" size="0.1 0.1 0.15" mass="10" material="bus_mat"/>
      <site name="imu" pos="0 0 0" size="0.01"/>

      <!-- Boom X: on +x face, extends along +x, swings about z (in the x-y plane) -->
      <body name="boom_x" pos="0.1 0 0">
        <joint name="hinge_x" axis="0 0 1"/>
        <geom type="capsule" fromto="0 0 0 0.5 0 0" size="0.01" mass="0.4" material="boom_x"/>
        <geom type="sphere" pos="0.5 0 0" size="0.03" mass="0.3" material="boom_x"/>
      </body>

      <!-- Boom Y: on +y face, extends along +y, swings about x (in the y-z plane) -->
      <body name="boom_y" pos="0 0.1 0">
        <joint name="hinge_y" axis="1 0 0"/>
        <geom type="capsule" fromto="0 0 0 0 0.5 0" size="0.01" mass="0.4" material="boom_y"/>
        <geom type="sphere" pos="0 0.5 0" size="0.03" mass="0.3" material="boom_y"/>
      </body>

      <!-- Boom Z: on +z face, extends along +z, swings about y (in the z-x plane) -->
      <body name="boom_z" pos="0 0 0.15">
        <joint name="hinge_z" axis="0 1 0"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.5" size="0.01" mass="0.4" material="boom_z"/>
        <geom type="sphere" pos="0 0 0.5" size="0.03" mass="0.3" material="boom_z"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="act_x" joint="hinge_x" gear="1"/>
    <motor name="act_y" joint="hinge_y" gear="1"/>
    <motor name="act_z" joint="hinge_z" gear="1"/>
  </actuator>

  <sensor>
    <gyro        name="gyro"     site="imu"/>
    <framequat   name="quat"     objtype="site" objname="imu"/>
    <jointpos    name="q_x"      joint="hinge_x"/>
    <jointpos    name="q_y"      joint="hinge_y"/>
    <jointpos    name="q_z"      joint="hinge_z"/>
    <jointvel    name="qd_x"     joint="hinge_x"/>
    <jointvel    name="qd_y"     joint="hinge_y"/>
    <jointvel    name="qd_z"     joint="hinge_z"/>
  </sensor>
</mujoco>
